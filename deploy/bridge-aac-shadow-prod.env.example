# Copy to /etc/default/bridge-aac-shadow-prod on the target host.
# Every reader must be a reachable, correctly typed endpoint. Do not duplicate
# one URL to manufacture quorum.

# Base must have two independently reachable execution readers from different
# operators. Production uses two public Base nodes: mainnet.base.org (Base) and
# base.publicnode.com (Allnodes). Both return chainId 0x2105 and agree on the
# finalized block hash. The 38.102.126.x hosts share one network block (Cogent
# COGENT-A), so they are not used as independent readers.
BRIDGE_AAC_BASE_RPC_1=https://mainnet.base.org
BRIDGE_AAC_BASE_RPC_2=https://base.publicnode.com

# CoNET may use the local execution reader plus the public archive reader.
BRIDGE_AAC_CONET_RPC_1=http://127.0.0.1:8545
BRIDGE_AAC_CONET_RPC_2=https://publicrpc.conet.network
