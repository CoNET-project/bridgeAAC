[Unit]
Description=bridgeAAC production read-only shadow observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peter
Group=peter
WorkingDirectory=/home/peter/bridgeAAC-prod
ExecStart=/home/peter/bin/bridge-aac-0.24.0 shadow-service --journal /var/lib/bridge-aac-prod/journal.json --cursor /var/lib/bridge-aac-prod/cursor.json --page /var/lib/bridge-aac-prod/page.txt --log /var/log/bridge-aac/prod-shadow.log --alert /var/log/bridge-aac/prod-alert.log --base-rpc http://127.0.0.1:8547 --base-rpc http://38.102.126.58:8547 --conet-rpc http://127.0.0.1:8889 --conet-rpc https://publicrpc.conet.network --interval 60
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
