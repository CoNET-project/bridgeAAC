[Unit]
Description=bridgeAAC production read-only shadow observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peter
Group=peter
WorkingDirectory=/home/peter/bridgeAAC-prod
EnvironmentFile=/etc/default/bridge-aac-shadow-prod
ExecStart=/home/peter/bin/bridge-aac-0.33.2 shadow-service --journal /var/lib/bridge-aac-prod/journal.json --cursor /var/lib/bridge-aac-prod/cursor.json --page /var/lib/bridge-aac-prod/page.txt --log /var/log/bridge-aac/prod-shadow.log --alert /var/log/bridge-aac/prod-alert.log --base-rpc ${BRIDGE_AAC_BASE_RPC_1} --base-rpc ${BRIDGE_AAC_BASE_RPC_2} --conet-rpc ${BRIDGE_AAC_CONET_RPC_1} --conet-rpc ${BRIDGE_AAC_CONET_RPC_2} --interval 60
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
